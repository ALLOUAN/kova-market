APP_NAME="KOVA MARKET"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

ADMIN_PATH=admin

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SCOUT_DRIVER=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="commandes@kovamarket.ci"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SMS_DRIVER=log
SMS_SENDER=KOVA

# WhatsApp Business: "twilio" (Twilio) or "cloud" (Meta Cloud API) send for real, "log" writes to storage/logs/whatsapp.log.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Twilio (WHATSAPP_DRIVER=twilio): account SID, auth token and the WhatsApp sender number (the sandbox number shown in the Twilio console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Cloudflare Turnstile on the public forms: contact, sign-up, checkout, tracking, stock alerts (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Security headers (config/security.php). Session cookies are Secure by default when APP_ENV=production.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false

# Error reporting (F-172): leave empty locally; set the project DSN in production and preproduction.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_TRACES_SAMPLE_RATE=0

# Online payment (CinetPay API v1). Keys of KOVA MARKET's own merchant account (espace marchand CinetPay).
# Without both keys, the online payment method is not offered at checkout.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
CINETPAY_BASE_URL=https://api.cinetpay.co
CINETPAY_CURRENCY=XOF
CINETPAY_FALLBACK_EMAIL=

# Meta Conversions API (Events Manager > pixel > Settings > Conversions API > Generate access token).
# The pixel ID itself is set in the back-office (Paramètres > Mesure d'audience).
META_CONVERSIONS_TOKEN=
META_TEST_EVENT_CODE=
